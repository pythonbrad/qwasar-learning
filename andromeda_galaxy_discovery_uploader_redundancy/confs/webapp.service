[Unit]
Description=Gunicorn instance to serve andromeda-pixie
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/andromeda-pixel
Environment="PATH=/home/ec2-user/andromeda-pixel/.venv/bin"
ExecStart=/home/ec2-user/andromeda-pixel/.venv/bin/gunicorn -k gevent flaskr:create_app()

[Install]
WantedBy=multi-user.target
